rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isBuyer() {
      return signedIn() && currentUser().role == 'buyer';
    }
    function isVerifiedSeller() {
      return signedIn() &&
        currentUser().role == 'seller' &&
        currentUser().subscribed == true;
    }
    function validNewChat(chatId) {
      let chat = request.resource.data;
      let buyRequest = get(/databases/$(database)/documents/requests/$(chat.requestId)).data;
      return chat.keys().hasOnly([
          'requestId', 'requestTitle', 'buyerId', 'buyerName', 'sellerId',
          'sellerName', 'participants', 'lastMessage', 'updatedAt'
        ]) &&
        chat.keys().hasAll([
          'requestId', 'requestTitle', 'buyerId', 'buyerName', 'sellerId',
          'sellerName', 'participants', 'lastMessage', 'updatedAt'
        ]) &&
        chat.sellerId == request.auth.uid &&
        chat.sellerName == currentUser().name &&
        chat.buyerId != request.auth.uid &&
        chat.buyerId == buyRequest.buyerId &&
        chat.buyerName == buyRequest.buyerName &&
        chat.requestTitle == buyRequest.title &&
        chat.participants == [chat.buyerId, request.auth.uid] &&
        chatId == chat.requestId + '__' + request.auth.uid &&
        chat.lastMessage is string;
    }
    function inChat(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    function inChatAfter(chatId) {
      return signedIn() &&
        request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // User profiles. Only the owner reads/edits their own; peer names are
    // denormalized onto chats so nobody else needs to read the profile.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'phone', 'location', 'bio', 'subscribed'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.phone is string &&
        request.resource.data.location is string &&
        request.resource.data.bio is string &&
        request.resource.data.role in ['buyer', 'seller'] &&
        request.resource.data.subscribed == false;
      // Profile fields only. `role` is fixed at signup so a buyer cannot promote
      // themselves to a seller, and the uid is pinned by the document path.
      // NOTE: `subscribed` is self-writable because the verification payment is
      // a client-side mock; a real deployment must set it from a server that has
      // confirmed the charge.
      allow update: if isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'location', 'bio', 'subscribed']) &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.location is string &&
        request.resource.data.bio is string &&
        request.resource.data.subscribed is bool;
      allow delete: if false;
    }

    // Open buy requests. Any signed-in user can browse; only the buyer who
    // posted can create. Sellers may only bump the response counter.
    match /requests/{id} {
      allow read: if signedIn();
      allow create: if isBuyer() &&
        request.resource.data.keys().hasOnly([
          'title', 'category', 'description', 'budget', 'buyerId',
          'buyerName', 'responseCount', 'createdAt'
        ]) &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.buyerName == currentUser().name &&
        request.resource.data.title is string &&
        request.resource.data.category is string &&
        request.resource.data.description is string &&
        request.resource.data.budget is string &&
        request.resource.data.buyerName is string &&
        request.resource.data.responseCount == 0;
      allow update: if isVerifiedSeller() &&
        resource.data.buyerId != request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['responseCount']) &&
        request.resource.data.responseCount == resource.data.responseCount + 1 &&
        !exists(/databases/$(database)/documents/chats/$(id + '__' + request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/chats/$(id + '__' + request.auth.uid));
      allow delete: if false;
    }

    // Chats and their messages. Readable/writable only by the two participants.
    match /chats/{chatId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participants;
      // Only the conversation preview may change. Membership and the request
      // link are written once at creation, so a participant cannot add a third
      // uid or repoint an existing chat at a different request.
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'updatedAt']) &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 4000;
      allow create: if isVerifiedSeller() && validNewChat(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if inChat(chatId);
        allow create: if inChatAfter(chatId) &&
          request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
